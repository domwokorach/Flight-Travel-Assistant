# Copy this file to .env.local and fill in values. Never commit .env.local.

# Which FlightProvider to use — "aerodatabox" and "airlabs" are implemented today.
FLIGHT_PROVIDER=aerodatabox

# AeroDataBox (RapidAPI) — powers live departures, arrivals, flight status, gates and terminals.
# Sign up at https://rapidapi.com/aedbx-aedbx/api/aerodatabox, subscribe to a plan (a free tier
# is available), and paste your RapidAPI key below. Without this, the app falls back to
# clearly-labeled demo flight data (isLive: false) so the UI still works end to end.
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=

# AirLabs (https://airlabs.co) — free-tier alternative to AeroDataBox. Set
# FLIGHT_PROVIDER=airlabs above to use this instead.
AIRLABS_API_KEY=
AIRLABS_BASE_URL=https://airlabs.co/api/v9

# Reserved for a future provider swap — not read by any code yet.
# Cirium FlightStats (native Connections API): https://developer.cirium.com
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
CIRIUM_BASE_URL=
# FlightAware AeroAPI (live tracking): https://www.flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=

# Open-Meteo weather — no key needed, this is only for a proxy/mock override.
WEATHER_BASE_URL=

# MapLibre + OpenFreeMap — powers the airport map, no key needed.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Google Maps Platform — Routes API + Places API (New), server-only, proxied through
# /api/directions/google and /api/places/search for the Flight Directions screen. Never
# sent to the browser. Requires Routes API and Places API (New) enabled + billing
# configured on the Google Cloud project. Get one at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Logo.dev publishable token — real airline logos in AirlineLogo.tsx. Publishable/client-safe
# by design; must keep the NEXT_PUBLIC_ prefix or the browser bundle never sees it.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Reserved for a future GTFS transport provider — not read by any code yet.
TRANSPORT_PROVIDER=
LONDON_GTFS_URL=
NEW_YORK_GTFS_URL=
AMSTERDAM_GTFS_URL=
