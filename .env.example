# =====================================================
# FLIGHTS
# =====================================================

# Which FlightProvider getFlightProvider() constructs (see src/lib/providers/flight/index.ts).
# "aerodatabox" and "airlabs" are implemented; "cirium"/"flightaware" fail fast with a clear
# error rather than silently degrading.
FLIGHT_PROVIDER=aerodatabox

# AeroDataBox (via RapidAPI) — implemented. Leave AERODATABOX_API_KEY blank to run on
# built-in demo data instead — see ENABLE_MOCK_DATA below. AERODATABOX_BASE_URL is
# optional, for pointing at a proxy/mock server in tests.
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=

# AirLabs (https://airlabs.co) — implemented, free-tier schedules API (10k req/mo on the
# free plan at time of writing). Select it with FLIGHT_PROVIDER=airlabs above. Its webhook
# Flight Alert API needs a paid plan, so this polls /schedules like AeroDataBox rather than
# receiving push updates.
AIRLABS_API_KEY=
AIRLABS_BASE_URL=https://airlabs.co/api/v9

# Cirium — future provider, not implemented yet. Both AeroDataBox and AirLabs derive
# connection journeys from two getFlight() calls (see flightService.getConnectionJourney);
# Cirium FlightStats offers a native Connections API, wired up via the optional
# FlightProvider.getConnection().
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
CIRIUM_BASE_URL=

# FlightAware — future provider, not implemented yet. AeroAPI is a candidate for live
# in-air tracking (altitude/speed/position) if that becomes a requirement.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=

# Force demo/mock flight data even if a flight provider API key is set.
ENABLE_MOCK_DATA=false


# =====================================================
# WEATHER
# =====================================================

# Open-Meteo — no API key required on the free public endpoint (up to 10k calls/day,
# non-commercial). WEATHER_BASE_URL is optional, for pointing at a proxy/mock in tests.
WEATHER_BASE_URL=https://api.open-meteo.com/v1


# =====================================================
# MAPS
# =====================================================

# MapLibre GL + OpenFreeMap — powers the airport map (AirportMap.tsx). No API key,
# registration, or request limit. Leave blank to use OpenFreeMap's "liberty" style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mapbox public token — still used for real routed driving/walking/cycling directions and
# address search ("enter a home/hotel address" on the directions panel); OpenFreeMap is
# tiles-only and doesn't cover routing/geocoding. Leave blank and both degrade gracefully
# (OSRM/estimate-only directions, address search hidden). Get one at
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps Platform — Routes API + Places API (New), server-only, proxied through
# /api/directions/google and /api/places/search for the Flight Directions screen (traffic-
# aware ground ETA, polyline, and free-text destination search). Never sent to the browser.
# Requires Routes API and Places API (New) enabled + billing configured on the Google Cloud
# project. Leave blank and the Flight Directions screen degrades to "Directions unavailable"
# rather than failing startup. Get one at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=


# =====================================================
# AIRLINE LOGOS
# =====================================================

# Logo.dev publishable token — powers real airline logos in AirlineLogo.tsx (domain lookup
# preferred, company-name lookup as fallback; see src/lib/airlineLogo.ts). This is a
# publishable/client-safe key by design, unlike the provider keys above — it's meant to be
# embedded in browser-rendered <img> URLs, hence the required NEXT_PUBLIC_ prefix. Leave
# blank and AirlineLogo falls back to its built-in IATA/initials badge.
NEXT_PUBLIC_LOGO_DEV_TOKEN=


# =====================================================
# TRANSPORT
# =====================================================

# Reserved seam for a future GTFS transport provider — not read by any code yet. TfL
# (src/lib/providers/transport/tfl.ts) remains the only implemented transport source today.
TRANSPORT_PROVIDER=

# Add individual feeds as required
LONDON_GTFS_URL=
NEW_YORK_GTFS_URL=
AMSTERDAM_GTFS_URL=


# =====================================================
# NOTIFICATIONS
# =====================================================

# Web push (VAPID keypair). Generate with `npx web-push generate-vapid-keys`.
# Leave both blank to disable push notifications (in-app toasts still work).
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

