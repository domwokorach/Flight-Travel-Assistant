# Flight data provider (AeroDataBox via RapidAPI). Leave blank to run on
# built-in demo data — see ENABLE_MOCK_DATA below.
AERODATABOX_API_KEY=

# Force demo/mock flight data even if AERODATABOX_API_KEY is set.
ENABLE_MOCK_DATA=false

# Mapbox public token — powers the airport map, real routed driving/walking/cycling
# directions, and address search ("enter a home/hotel address" on the directions panel).
# Leave blank and each of those degrades gracefully (map unavailable, OSRM/estimate-only
# directions, address search hidden). Get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Web push (VAPID keypair). Generate with `npx web-push generate-vapid-keys`.
# Leave both blank to disable push notifications (in-app toasts still work).
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

